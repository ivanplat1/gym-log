type M = { k: number; p: number; c: number; f: number }

function scaleM(m: M, grams: number): M {
  const x = grams / 100
  return { k: m.k * x, p: m.p * x, c: m.c * x, f: m.f * x }
}

function sumM(...parts: M[]): M {
  return parts.reduce(
    (a, b) => ({ k: a.k + b.k, p: a.p + b.p, c: a.c + b.c, f: a.f + b.f }),
    { k: 0, p: 0, c: 0, f: 0 },
  )
}

